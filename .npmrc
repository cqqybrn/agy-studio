# better-sqlite3 ships prebuilt binaries (prebuilds/<platform>-<arch>.node), but
# because the package contains binding.gyp npm would still run an implicit
# `node-gyp rebuild` on install. That needs Visual Studio C++ build tools on
# Windows and fails on machines without them. The other install scripts in the
# tree (esbuild, fsevents) are optional, so skip them all.
ignore-scripts=true
